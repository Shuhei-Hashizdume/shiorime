#データベース（PostgreSQL のコンテナが初めて起動したときに使う）

POSTGRES_USER=shiorime
POSTGRES_PASSWORD=example.password
POSTGRES_DB=shiorime

# Caddy が受け付けるアドレス。手元では空のまま（:80 で http://localhost を配る）。
# 本番では独自ドメインを書くと、Caddy が自動で HTTPS にする（例：SITE_ADDRESS=shiorime.example.com）
SITE_ADDRESS=

# JWT の署名の鍵（32文字以上）。次のコマンドで作った値を書く。開発用と本番用で別の値にする
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
