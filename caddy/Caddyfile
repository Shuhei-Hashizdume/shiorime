{$SITE_ADDRESS} {
	encode zstd gzip

	# /api/ で始まる頼みは FastAPI へ回す
	handle /api/* {
		# 巨大なデータを入口で止める（api.md 5-1）
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	# それ以外は、ビルドした画面のファイルを配る。
	# 見つからない URL（/books/… など）は index.html を返し、React が画面を決める。
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
